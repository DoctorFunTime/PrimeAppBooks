<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.BadDebtsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:PrimeAppBooks.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=pages:BadDebtsPageViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!--  Left Side: Customer List  -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,20"
                Padding="20"
                Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource WelcomeTitleText}" Text="❌ Bad Debts Management" />
                    <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="Review accounts with outstanding balances and process value write-offs." />
                </StackPanel>
            </Border>

            <!--  Customer List  -->
            <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="All"
                    ItemsSource="{Binding CustomersWithBalances}"
                    IsReadOnly="True"
                    SelectedItem="{Binding SelectedCustomer}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Style="{StaticResource ModernDataGridStyle}">

                    <!--  Set row height and vertical alignment with enhanced selection state  -->
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2A4A7B" />
                                    <!--  Selected background color  -->
                                    <Setter Property="BorderBrush" Value="#4472C4" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E3A5F" />
                                    <!--  Hover color  -->
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!--  Enhanced cell styling with selection state  -->
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <!--  Let row handle background  -->
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!--  Update column header style  -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="#FF4472C4" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Height" Value="35" />
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#3A3A3A" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Customer.CustomerName}"
                            Header="Customer Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="Gainsboro" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Customer.CustomerCode}"
                            Header="Code">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#AAAAAA" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Customer.Phone}"
                            Header="Phone">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="Gainsboro" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Balance, StringFormat={}{0:C}}"
                            Header="Receiveable Balance">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#E74C3C" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!--  Right Side: Action Panel  -->
        <Border
            Grid.Column="1"
            Padding="0"
            Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="20"
                    Background="#10FFFFFF"
                    CornerRadius="8,8,0,0">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Write-Off Details" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!--  No Selection State  -->
                        <StackPanel Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="48"
                                Text="👈" />
                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="#80FFFFFF"
                                Text="Select a customer to proceed" />
                        </StackPanel>

                        <!--  Details Form  -->
                        <StackPanel Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}">
                            <!--  Customer Summary  -->
                            <Border
                                Margin="0,0,0,20"
                                Padding="15"
                                Background="#15FFFFFF"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedCustomer.Customer.CustomerName}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="#80FFFFFF"
                                        Text="{Binding SelectedCustomer.Customer.CustomerCode}" />
                                    <Border
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Padding="10,5"
                                        Background="#30E74C3C"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Foreground="#E74C3C"
                                            Text="{Binding SelectedCustomer.Balance, StringFormat='{}Outstanding: {0:C}'}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  Write Off Input  -->
                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Amount to Write Off" />
                            <hc:TextBox
                                Margin="0,5,0,20"
                                hc:InfoElement.Placeholder="0.00"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding WriteOffAmount}" />

                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Reason / Notes" />
                            <hc:TextBox
                                Height="80"
                                Margin="0,5,0,20"
                                AcceptsReturn="True"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding WriteOffNotes}"
                                TextWrapping="Wrap" />

                            <!--  Inactive Toggle  -->
                            <CheckBox
                                Margin="0,0,0,20"
                                Content="Mark Customer as Inactive/Disabled"
                                IsChecked="{Binding MarkAsInactive}"
                                ToolTip="Disable this customer account for future transactions"/>

                            <Border
                                Padding="15"
                                Background="#20E67E22"
                                BorderBrush="#E67E22"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="#E67E22"
                                            Text="⚠ Warning" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        FontSize="12"
                                        Foreground="#D0FFFFFF"
                                        Text="This action will create a permanent journal entry expensing this debt and crediting the Accounts Receivable. This cannot be easily undone."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!--  Action Buttons  -->
                <Border
                    Grid.Row="2"
                    Padding="20"
                    Background="#10FFFFFF"
                    CornerRadius="0,0,8,8"
                    Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}">
                    <Button
                        HorizontalAlignment="Stretch"
                        Background="#E74C3C"
                        Command="{Binding ProcessWriteOffCommand}"
                        Content="Confirm Write-Off"
                        Foreground="White"
                        Style="{StaticResource ModernActionButton}" />
                </Border>
            </Grid>
        </Border>

        <!--  Loading Overlay  -->
        <Border
            Grid.ColumnSpan="2"
            Background="#80000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="60"
                    Height="60"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}" />
                <TextBlock
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource DetailValueText}"
                    Text="Processing..." />
            </StackPanel>
        </Border>
    </Grid>
</base:BaseAnimatedPage>
