<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.AssetRegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:converters="clr-namespace:PrimeAppBooks.Conveters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PrimeAppBooks.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:AssetRegisterPageViewModel}"
    d:DesignHeight="750"
    d:DesignWidth="1200"
    Background="Transparent"
    mc:Ignorable="d">

    <base:BaseAnimatedPage.Resources>
        <converters:AmountDisplayConverter x:Key="AmountDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </base:BaseAnimatedPage.Resources>

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border Grid.Row="0" Margin="5,0" Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource WelcomeTitleText}" Text="🏢 Asset Register" />
                        <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="Track fixed assets, depreciation and disposals" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Margin="5,0"
                            Command="{Binding RunDepreciationCommand}"
                            Content="📅 Run Depreciation"
                            Style="{StaticResource ModernSecondaryButton}" />
                        <Button
                            Margin="5,0"
                            Command="{Binding AddNewAssetCommand}"
                            Content="➕ New Asset"
                            Style="{StaticResource ModernActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Summary Stats  -->
            <UniformGrid Grid.Row="1" Margin="5,10" Columns="4">
                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel Style="{StaticResource CardContentContainer}">
                        <TextBlock Style="{StaticResource DraftHeaderText}" Text="📋 Total Assets" />
                        <TextBlock Style="{StaticResource CardValueText}" Text="{Binding TotalAssetsCount}" />
                        <TextBlock Style="{StaticResource CardSubText}" Text="In register" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel Style="{StaticResource CardContentContainer}">
                        <TextBlock Style="{StaticResource BalanceHeaderText}" Text="💰 Total Cost" />
                        <TextBlock Style="{StaticResource CardValueText}" Text="{Binding TotalCost, Converter={StaticResource AmountDisplayConverter}}" />
                        <TextBlock Style="{StaticResource CardSubText}" Text="Original purchase cost" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel Style="{StaticResource CardContentContainer}">
                        <TextBlock Style="{StaticResource CardSubText}" Text="📊 Net Book Value" />
                        <TextBlock Style="{StaticResource CardValueText}" Text="{Binding TotalBookValue, Converter={StaticResource AmountDisplayConverter}}" />
                        <TextBlock Style="{StaticResource CardSubText}" Text="After depreciation" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel Style="{StaticResource CardContentContainer}">
                        <TextBlock Style="{StaticResource CardSubText}" Text="⚠️ Fully Depreciated" />
                        <TextBlock
                            Foreground="#E74C3C"
                            Style="{StaticResource CardValueText}"
                            Text="{Binding FullyDepreciatedCount}" />
                        <TextBlock Style="{StaticResource CardSubText}" Text="Assets at residual value" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  Filter Bar  -->
            <Border Grid.Row="2" Margin="5,0,5,10" Style="{StaticResource ModernCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Text="🔍  " />
                    <TextBox
                        Width="250"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Search by name, code, or category" />
                    <TextBlock
                        Margin="15,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Text="Status:" />
                    <ComboBox
                        Width="180"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding StatusFilter}"
                        Style="{StaticResource ModernComboBox}" />
                    <Button
                        Margin="15,0,0,0"
                        Command="{Binding LoadDataCommand}"
                        Content="🔄 Refresh"
                        Style="{StaticResource ModernSecondaryButton}" />
                </StackPanel>
            </Border>

            <!--  Asset Grid  -->
            <Border Grid.Row="3" Margin="5,0" Style="{StaticResource ModernCardStyle}">
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    MaxWidth="950"
                    ItemsSource="{Binding FilteredAssets}"
                    SelectedItem="{Binding SelectedAsset}"
                    Style="{StaticResource ModernDataGridStyle}">

                    <!--  Update column header style  -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="#FF4472C4" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="9" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Height" Value="35" />
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#3A3A3A" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    
                    <!--  Enhanced cell styling with selection state  -->
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <!--  Let row handle background  -->
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding AssetCode}"
                            Header="Code" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding AssetName}"
                            Header="Asset Name" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding Category.CategoryName}"
                            Header="Category" />
                        <DataGridTextColumn
                            Width="105"
                            Binding="{Binding PurchaseDate, StringFormat=dd MMM yyyy}"
                            Header="Purchase Date" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding PurchaseCost, StringFormat=N2}"
                            Header="Cost" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding AccumulatedDepreciation, StringFormat=N2}"
                            Header="Accum. Depn" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding BookValue, StringFormat=N2}"
                            Header="Book Value" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding DepreciationMethod}"
                            Header="Method" />
                        <DataGridTemplateColumn Width="105" Header="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="3"
                                        Padding="6,2"
                                        CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#27AE6022" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="CWIP">
                                                        <Setter Property="Background" Value="#273498DB" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="FULLY_DEPRECIATED">
                                                        <Setter Property="Background" Value="#27F39C12" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="DISPOSED">
                                                        <Setter Property="Background" Value="#27E74C3C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="ACTIVE" />
                                                    <Setter Property="Foreground" Value="#27AE60" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="CWIP">
                                                            <Setter Property="Text" Value="IN CWIP" />
                                                            <Setter Property="Foreground" Value="#3498DB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="FULLY_DEPRECIATED">
                                                            <Setter Property="Text" Value="FULLY DEPR." />
                                                            <Setter Property="Foreground" Value="#F39C12" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="DISPOSED">
                                                            <Setter Property="Text" Value="DISPOSED" />
                                                            <Setter Property="Foreground" Value="#E74C3C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="130" Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  Capitalize button: only shown for CWIP assets  -->
                                        <Button
                                            Margin="2"
                                            Command="{Binding DataContext.CapitalizeAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="⚡"
                                            ToolTip="Capitalize asset (move from CWIP to fixed asset account)">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource ModernIconButton}" TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="CWIP">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Margin="2"
                                            Command="{Binding DataContext.EditAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="✏️"
                                            Style="{StaticResource ModernIconButton}"
                                            ToolTip="Edit Asset" />
                                        <Button
                                            Margin="2"
                                            Command="{Binding DataContext.DisposeAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="🗑️"
                                            Style="{StaticResource ModernIconButton}"
                                            ToolTip="Dispose Asset" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>
