<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.AddEditAssetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PrimeAppBooks.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:AddEditAssetPageViewModel}"
    d:DesignHeight="780"
    d:DesignWidth="1000"
    Background="Transparent"
    mc:Ignorable="d">

    <base:BaseAnimatedPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </base:BaseAnimatedPage.Resources>

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="10">
            <Border
                MaxWidth="1000"
                VerticalAlignment="Top"
                Style="{StaticResource ModernCardStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Page Header  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource WelcomeTitleText}" Text="{Binding PageTitle}" />
                        <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="All fields marked * are required" />
                    </StackPanel>

                    <!--  === DISPOSAL MODE PANEL ===  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,15"
                        Padding="15"
                        Background="#0DE74C3C"
                        BorderBrush="#E74C3C"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsDisposalMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#E74C3C"
                                Text="âš ï¸ Disposal Details" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,5" Foreground="Gray" Text="Disposal Date *" />
                                    <DatePicker SelectedDate="{Binding DisposalDate}" Style="{StaticResource CompactDatePickerStyle}" />

                                    <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Disposal Type *" />
                                    <ComboBox
                                        ItemsSource="{Binding DisposalTypes}"
                                        SelectedItem="{Binding DisposalType}"
                                        Style="{StaticResource ModernComboBox}" />

                                    <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Sale Proceeds" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding DisposalProceeds, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,5" Foreground="Gray" Text="Proceeds Bank/Cash Account" />
                                    <ComboBox
                                        DisplayMemberPath="FullName"
                                        ItemsSource="{Binding BankCashAccounts}"
                                        SelectedItem="{Binding SelectedProceedsAccount}"
                                        Style="{StaticResource ModernComboBox}" />

                                    <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Disposal Notes" />
                                    <TextBox
                                        Height="60"
                                        AcceptsReturn="True"
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        Text="{Binding DisposalNotes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  === ASSET DETAIL FORM ===  -->
                    <Grid Grid.Row="2" Visibility="{Binding IsNotDisposalMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Left Column  -->
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SectionHeaderText}"
                                Text="Asset Details" />

                            <TextBlock Margin="0,5" Foreground="Gray" Text="Asset Code (auto if blank)" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding AssetCode, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Asset Name *" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding AssetName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Category *" />
                            <ComboBox
                                DisplayMemberPath="CategoryName"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                Style="{StaticResource ModernComboBox}" />

                            <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Description" />
                            <TextBox
                                Height="60"
                                AcceptsReturn="True"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Notes" />
                            <TextBox
                                Height="50"
                                AcceptsReturn="True"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="0,20,0,10"
                                Style="{StaticResource SectionHeaderText}"
                                Text="Acquisition" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,5" Foreground="Gray" Text="Purchase Date *" />
                                    <DatePicker SelectedDate="{Binding PurchaseDate}" Style="{StaticResource CompactDatePickerStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,5" Foreground="Gray" Text="Purchase Cost *" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PurchaseCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Acquisition Offset Account *" />
                            <ComboBox
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding AcquisitionOffsetAccounts}"
                                SelectedItem="{Binding SelectedAcquisitionOffsetAccount}"
                                Style="{StaticResource ModernComboBox}" />

                            <!--  CWIP Staging  -->
                            <Border
                                Margin="0,15,0,0"
                                Padding="12,10"
                                Background="#0A3498DB"
                                BorderBrush="#3A3498DB"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <CheckBox
                                        Content="Stage to Capital Work in Progress (CWIP)"
                                        FontSize="13"
                                        Foreground="#3498DB"
                                        IsChecked="{Binding IsStagedToCwip}"
                                        ToolTip="Post cost to a CWIP staging account. Depreciation will not run until you Capitalise the asset." />

                                    <!--  Shown only when checkbox is ticked  -->
                                    <StackPanel Visibility="{Binding IsCwipAccountVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            Margin="0,10,0,5"
                                            Foreground="Gray"
                                            Text="CWIP Staging Account *" />
                                        <ComboBox
                                            DisplayMemberPath="FullName"
                                            ItemsSource="{Binding CwipAccounts}"
                                            SelectedItem="{Binding SelectedCwipAccount}"
                                            Style="{StaticResource ModernComboBox}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="10"
                                            Foreground="#3498DB"
                                            Text="ℹ️  Cost will be staged to the CWIP account. Depreciation only begins after you Capitalise from the Asset Register."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  Right Column  -->
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SectionHeaderText}"
                                Text="Depreciation Setup" />

                            <TextBlock Margin="0,5" Foreground="Gray" Text="Depreciation Method *" />
                            <ComboBox
                                ItemsSource="{Binding DepreciationMethods}"
                                SelectedItem="{Binding SelectedDepreciationMethod}"
                                Style="{StaticResource ModernComboBox}" />
                            <TextBlock
                                Margin="0,2,0,8"
                                FontSize="10"
                                Foreground="DimGray"
                                Text="{Binding DepreciationMethodLabel}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,5" Foreground="Gray" Text="Useful Life (Years) *" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding UsefulLifeYears, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,5" Foreground="Gray" Text="Residual Value" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ResidualValue, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,3,0,8"
                                FontSize="10"
                                Foreground="DimGray"
                                Text="Depreciation starts pro-rata from the purchase date."
                                TextWrapping="Wrap" />

                            <!--  GL Accounts  -->
                            <TextBlock
                                Margin="0,15,0,10"
                                Style="{StaticResource SectionHeaderText}"
                                Text="GL Accounts" />

                            <TextBlock Margin="0,5" Foreground="Gray" Text="Asset Account (e.g. 1430 Equipment) *" />
                            <ComboBox
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding FixedAssetAccounts}"
                                SelectedItem="{Binding SelectedAssetAccount}"
                                Style="{StaticResource ModernComboBox}" />

                            <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Accumulated Depreciation Account *" />
                            <ComboBox
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding AccumDepnAccounts}"
                                SelectedItem="{Binding SelectedAccumDepnAccount}"
                                Style="{StaticResource ModernComboBox}" />

                            <TextBlock Margin="0,10,0,5" Foreground="Gray" Text="Depreciation Expense Account *" />
                            <ComboBox
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding DepnExpenseAccounts}"
                                SelectedItem="{Binding SelectedDepnExpenseAccount}"
                                Style="{StaticResource ModernComboBox}" />

                        </StackPanel>
                    </Grid>

                    <!--  Action Buttons (always visible)  -->
                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Grid.Row="2"
                            Width="100"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource ModernSecondaryButton}" />
                        <Button
                            Grid.Row="2"
                            Width="150"
                            Margin="10,0,0,0"
                            Command="{Binding SaveCommand}"
                            Content="{Binding SaveButtonText}"
                            Style="{StaticResource ModernActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>
