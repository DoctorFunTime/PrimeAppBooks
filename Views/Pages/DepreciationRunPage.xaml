<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.DepreciationRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PrimeAppBooks.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:DepreciationRunViewModel}"
    d:DesignHeight="750"
    d:DesignWidth="1000"
    Background="Transparent"
    mc:Ignorable="d">

    <base:BaseAnimatedPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </base:BaseAnimatedPage.Resources>

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource WelcomeTitleText}" Text="📅 Run Depreciation" />
                    <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="Select a period, preview amounts, then post the journal entry" />
                </StackPanel>
            </Border>

            <!--  Period Selection  -->
            <Border Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,5" Foreground="Gray" Text="Period Start" />
                        <DatePicker SelectedDate="{Binding PeriodStartDate}" Style="{StaticResource CompactDatePickerStyle}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,5"
                        Foreground="Gray"
                        Text="to" />

                    <StackPanel Grid.Column="4">
                        <TextBlock Margin="0,5" Foreground="Gray" Text="Period End" />
                        <DatePicker SelectedDate="{Binding PeriodEndDate}" Style="{StaticResource CompactDatePickerStyle}" />
                    </StackPanel>

                    <Button
                        Grid.Column="6"
                        Width="140"
                        Margin="0,20,0,0"
                        Command="{Binding PreviewCommand}"
                        Content="🔍 Preview Run"
                        Style="{StaticResource ModernActionButton}" />
                </Grid>
            </Border>

            <!--  Preview Grid (shown after preview)  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,10"
                Style="{StaticResource ModernCardStyle}"
                Visibility="{Binding IsPreviewed, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{StaticResource SectionHeaderText}"
                        Text="{Binding PeriodLabel, StringFormat='Preview — {0}'}" />

                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                                                    MaxWidth="930"
                        IsReadOnly="False"
                        ItemsSource="{Binding AssetRows}"
                        Style="{StaticResource ModernDataGridStyle}">
                        
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn
                                Width="50"
                                Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                Header="✓" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Asset.AssetCode}"
                                Header="Code"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Asset.AssetName}"
                                Header="Asset Name"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Method}"
                                Header="Method"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="115"
                                Binding="{Binding Asset.BookValue, StringFormat=N2}"
                                Header="Current Book Value"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="115"
                                Binding="{Binding CalculatedAmount, StringFormat=N2}"
                                Header="Depreciation"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                        <!--  Update column header style  -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="#FF4472C4" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="FontFamily" Value="Segoe UI" />
                                <Setter Property="FontSize" Value="9" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Height" Value="35" />
                                <Setter Property="Background" Value="#1E1E1E" />
                                <Setter Property="BorderBrush" Value="#3A3A3A" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <!--  Enhanced cell styling with selection state  -->
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <!--  Let row handle background  -->
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!--  Footer: Total + Post  -->
            <Border
                Grid.Row="3"
                Style="{StaticResource ModernCardStyle}"
                Visibility="{Binding IsPreviewed, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock>
                            <Run Foreground="Gray" Text="Eligible Assets: " />
                            <Run FontWeight="SemiBold" Text="{Binding EligibleAssetsCount}" />
                            <Run Foreground="Gray" Text="    Total Depreciation: " />
                            <Run FontSize="16" FontWeight="Bold" Text="{Binding TotalDepreciation, StringFormat=N2}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <Button
                            Width="100"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource ModernSecondaryButton}" />
                        <Button
                            Width="180"
                            Margin="10,0,0,0"
                            Command="{Binding PostDepreciationCommand}"
                            Content="✅ Post Journal Entry"
                            Style="{StaticResource ModernActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>
