<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.AddVendorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:PrimeAppBooks.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=pages:AddVendorPageViewModel}"
    d:DesignHeight="8000"
    d:DesignWidth="1100"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border 
                Grid.Row="0"
                Margin="0,0,0,20"
                HorizontalAlignment="Left"
                Style="{StaticResource ModernCardStyle}" Width="1030">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource WelcomeTitleText}" Text="{Binding PageTitle}" />
                        <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="Register and manage your vendor relationships and financial settings" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="5,0" Command="{Binding NavigateBackCommand}" Content="← Back" Style="{StaticResource ModernSecondaryButton}" />
                        <Button Margin="5,0" Command="{Binding SaveVendorCommand}" Content="💾 Save Vendor" Style="{StaticResource ModernActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <StackPanel Grid.Row="1">
                <!-- Basic Information -->
                <Border Margin="0,0,0,20" Style="{StaticResource ModernCardStyle}" Width="1030" HorizontalAlignment="Left">
                    <StackPanel Margin="10">
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="📋 Basic Information" Margin="0,0,0,20" />

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}" Text="Vendor Name: *" />
                            <hc:TextBox Grid.Column="1" hc:InfoElement.Placeholder="Enter Vendor Name" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding VendorName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="3" Style="{StaticResource SettingsLabelStyle}" Text="Vendor Code: *" />
                            <hc:TextBox Grid.Column="4" hc:InfoElement.Placeholder="V-XXXX" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding VendorCode, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}" Text="Contact Person:" />
                            <hc:TextBox Grid.Column="1" hc:InfoElement.Placeholder="Primary contact name" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ContactPerson}" />

                            <TextBlock Grid.Column="3" Style="{StaticResource SettingsLabelStyle}" Text="Tax ID / VAT #:" />
                            <hc:TextBox Grid.Column="4" hc:InfoElement.Placeholder="Tax registration number" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding TaxId}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}" Text="Email:" />
                            <hc:TextBox Grid.Column="1" hc:InfoElement.Placeholder="example@vendor.com" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Email}" />

                            <TextBlock Grid.Column="3" Style="{StaticResource SettingsLabelStyle}" Text="Phone:" />
                            <hc:TextBox Grid.Column="4" hc:InfoElement.Placeholder="Contact number" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Phone}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Financial Configuration -->
                <Border Margin="0,0,0,20" Style="{StaticResource ModernCardStyle}" Width="1030" HorizontalAlignment="Left">
                    <StackPanel Margin="10">
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="⚙️ Financial Settings" Margin="0,0,0,20" />

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}" Text="Default Expense Account:" />
                            <StackPanel Grid.Column="1">
                                <ComboBox ItemsSource="{Binding ExpenseAccounts}" SelectedItem="{Binding SelectedExpenseAccount}" Style="{StaticResource ModernComboBox}" DisplayMemberPath="AccountName" />
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#60FFFFFF" Text="This account will be pre-filled in purchase invoices for this vendor." />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}" Text="Status:" />
                            <CheckBox Grid.Column="1" Content="Vendor is Active" IsChecked="{Binding IsActive}" Foreground="White" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Additional Information -->
                <Border Margin="0,0,0,20" Style="{StaticResource ModernCardStyle}" Width="1030" HorizontalAlignment="Left">
                    <StackPanel Margin="10">
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="📍 Additional Details" Margin="0,0,0,20" />

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}" Text="Address:" />
                            <hc:TextBox Grid.Column="1" Height="60" hc:InfoElement.Placeholder="Street address, city, etc." AcceptsReturn="True" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Address}" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}" Text="Internal Notes:" />
                            <hc:TextBox Grid.Column="1" Height="80" hc:InfoElement.Placeholder="Add any private notes here..." AcceptsReturn="True" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Notes}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Loading Overlay -->
           <!-- <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="80" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center" Style="{StaticResource DetailValueText}" Text="Saving Vendor..." Foreground="White" />
                </StackPanel>
            </Border>-->
        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>
