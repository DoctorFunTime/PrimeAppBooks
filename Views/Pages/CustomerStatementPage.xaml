<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.CustomerStatementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Customer Statement"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header Section  -->
            <Border
                Grid.Row="0"
                Margin="5,0"
                Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Back Button  -->
                    <Button
                        Grid.Column="0"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        ToolTip="Go Back">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Kind="ArrowLeft" />
                    </Button>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource WelcomeTitleText}" Text="Statement of Account" />
                        <TextBlock
                            FontSize="16"
                            Foreground="#A0A0A0"
                            Text="{Binding Customer.CustomerName, StringFormat='Customer: {0}'}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <DatePicker
                            Width="120"
                            Margin="0,0,10,0"
                            materialDesign:HintAssist.Hint="Start Date"
                            SelectedDate="{Binding StartDate}"
                            Style="{StaticResource CompactDatePickerStyle}" />
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="#808080"
                            Text="to" />
                        <DatePicker
                            Width="120"
                            Margin="0,0,10,0"
                            materialDesign:HintAssist.Hint="End Date"
                            SelectedDate="{Binding EndDate}"
                            Style="{StaticResource CompactDatePickerStyle}" />
                        <Button
                            Command="{Binding RefreshStatementCommand}"
                            Content="Update View"
                            Style="{StaticResource ModernActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Summary Cards  -->
            <Grid Grid.Row="1" Margin="5,10">
                <UniformGrid Columns="3">
                    <!--  Total Invoiced  -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <StackPanel Style="{StaticResource CardContentContainer}">
                            <TextBlock Style="{StaticResource PostedHeaderText}" Text="📝 Total Invoiced" />
                            <TextBlock Style="{StaticResource CardValueText}" Text="{Binding TotalInvoiced, StringFormat=C}" />
                            <TextBlock Style="{StaticResource CardSubText}" Text="Total charges for period" />
                        </StackPanel>
                    </Border>

                    <!--  Total Paid  -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <StackPanel Style="{StaticResource CardContentContainer}">
                            <TextBlock Style="{StaticResource BalanceHeaderText}" Text="✅ Total Paid" />
                            <TextBlock
                                Foreground="#27AE60"
                                Style="{StaticResource CardValueText}"
                                Text="{Binding TotalPaid, StringFormat=C}" />
                            <TextBlock Style="{StaticResource CardSubText}" Text="Total payments received" />
                        </StackPanel>
                    </Border>

                    <!--  Closing Balance  -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <StackPanel Style="{StaticResource CardContentContainer}">
                            <TextBlock Style="{StaticResource MonthlyHeaderText}" Text="💰 Closing Balance" />
                            <TextBlock
                                Foreground="{StaticResource PrimaryBrush}"
                                Style="{StaticResource CardValueText}"
                                Text="{Binding ClosingBalance, StringFormat=C}" />
                            <TextBlock Style="{StaticResource CardSubText}" Text="Ending balance for period" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!--  Main Content  -->
            <Border
                Grid.Row="2"
                Margin="5,0"
                Padding="8"
                Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,15"
                        Style="{StaticResource SectionHeaderText}"
                        Text="📄 Transaction History" />

                    <DataGrid
                        Grid.Row="1"
                        MaxHeight="488"
                        HorizontalAlignment="Stretch"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="None"
                        IsReadOnly="True"
                        ItemsSource="{Binding Transactions}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        Style="{StaticResource ModernDataGridStyle}">

                        <!--  Set row height and vertical alignment with enhanced selection state  -->
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                                <Setter Property="Height" Value="60" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2A4A7B" />
                                        <!--  Selected background color  -->
                                        <Setter Property="BorderBrush" Value="#4472C4" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E3A5F" />
                                        <!--  Hover color  -->
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!--  Enhanced cell styling with selection state  -->
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <!--  Let row handle background  -->
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!--  Update column header style  -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="#FF4472C4" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="FontFamily" Value="Segoe UI" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Height" Value="50" />
                                <Setter Property="Background" Value="#1E1E1E" />
                                <Setter Property="BorderBrush" Value="#3A3A3A" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!--  Date  -->
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Date, StringFormat='MMM dd, yyyy'}"
                                Header="Date" />

                            <!--  Reference  -->
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Reference}"
                                Header="Reference" />

                            <!--  Description  -->
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Description}"
                                Header="Description" />

                            <!--  Debit  -->
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Debit, StringFormat=C}"
                                Header="Charges">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="IndianRed" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!--  Credit  -->
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Credit, StringFormat=C}"
                                Header="Payments">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="#27AE60" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!--  Balance  -->
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding RunningBalance, StringFormat=C}"
                                Header="Balance">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  Loading Overlay  -->
                    <Border
                        Grid.RowSpan="2"
                        Background="#80000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar
                            Width="50"
                            Height="50"
                            IsIndeterminate="True"
                            Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>