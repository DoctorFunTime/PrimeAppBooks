<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.AddEditInventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PrimeAppBooks.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:AddEditInventoryPageViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="10">
            <Border
                MaxWidth="1000"
                VerticalAlignment="Top"
                Style="{StaticResource ModernCardStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource WelcomeTitleText}" Text="{Binding PageTitle}" />
                        <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="Enter item details and GL mapping" />
                    </StackPanel>

                    <!--  Form Content  -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Left Column: Basic Info  -->
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SectionHeaderText}"
                                Text="Basic Information" />

                            <TextBlock
                                Margin="0,5"
                                Foreground="Gray"
                                Text="SKU / Code" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="0,10,0,5"
                                Foreground="Gray"
                                Text="Item Name" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="0,10,0,5"
                                Foreground="Gray"
                                Text="Description" />
                            <TextBox
                                Height="80"
                                AcceptsReturn="True"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="0,10,0,5"
                                Foreground="Gray"
                                Text="Initial Quantity On Hand" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding QuantityOnHand, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,2,0,5"
                                FontSize="10"
                                Foreground="DimGray"
                                Text="Physical stock currently in your possession. Enter 0 if you have no starting stock (stock is added automatically when purchase bills are posted)."
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,10,0,5"
                                Foreground="Gray"
                                Text="Low Stock Threshold" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,2,0,5"
                                FontSize="10"
                                Foreground="DimGray"
                                Text="Minimum stock level before alerts appear in your inventory list."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  Right Column: Pricing & Accounting  -->
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SectionHeaderText}"
                                Text="Pricing &amp; Accounts" />

                            <!--  Pricing  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,5"
                                        Foreground="Gray"
                                        Text="Sale Price" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                                    <TextBlock
                                        Margin="0,2,0,5"
                                        FontSize="10"
                                        Foreground="DimGray"
                                        Text="Default price charged to customers."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,5"
                                        Foreground="Gray"
                                        Text="Purchase Cost (Avg)" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PurchaseCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                                    <TextBlock
                                        Margin="0,2,0,5"
                                        FontSize="10"
                                        Foreground="DimGray"
                                        Text="Average per-unit cost paid to vendors."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,15,0,10"
                                FontSize="14"
                                Style="{StaticResource SectionHeaderText}"
                                Text="GL Accounts" />

                            <TextBlock
                                Margin="0,5"
                                Foreground="Gray"
                                Text="Income Account (Sales)" />
                            <ComboBox
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding IncomeAccounts}"
                                SelectedItem="{Binding SelectedIncomeAccount}"
                                Style="{StaticResource ModernComboBox}" />
                            <TextBlock
                                Margin="0,2,0,5"
                                FontSize="10"
                                Foreground="DimGray"
                                Text="Revenue account credited when this item is sold (e.g. 4000 - Sales Revenue)."
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,10,0,5"
                                Foreground="Gray"
                                Text="Expense Account (COGS)" />
                            <ComboBox
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding ExpenseAccounts}"
                                SelectedItem="{Binding SelectedExpenseAccount}"
                                Style="{StaticResource ModernComboBox}" />
                            <TextBlock
                                Margin="0,2,0,5"
                                FontSize="10"
                                Foreground="DimGray"
                                Text="Cost of Goods Sold account debited when items are sold to record cost of sales."
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,10,0,5"
                                Foreground="Gray"
                                Text="Asset Account (Inventory)" />
                            <ComboBox
                                DisplayMemberPath="FullName"
                                ItemsSource="{Binding AssetAccounts}"
                                SelectedItem="{Binding SelectedAssetAccount}"
                                Style="{StaticResource ModernComboBox}" />
                            <TextBlock
                                Margin="0,2,0,5"
                                FontSize="10"
                                Foreground="DimGray"
                                Text="Balance sheet asset account tracking value of physical items currently on hand."
                                TextWrapping="Wrap" />

                            <!--  Buttons  -->
                            <StackPanel
                                Margin="0,30,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    Width="100"
                                    Command="{Binding CancelCommand}"
                                    Content="Cancel"
                                    Style="{StaticResource ModernSecondaryButton}" />
                                <Button
                                    Width="120"
                                    Margin="10,0,0,0"
                                    Command="{Binding SaveCommand}"
                                    Content="Save Item"
                                    Style="{StaticResource ModernActionButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>
