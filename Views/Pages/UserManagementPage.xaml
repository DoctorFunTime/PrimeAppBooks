<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1280"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header Section  -->
            <Border
                Grid.Row="0"
                Margin="5,5,5,15"
                Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource WelcomeTitleText}" Text="👥 User Management" />
                        <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="Manage system user accounts, roles, and your account profile" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Main Content Area  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Left Column: Edit Own Account & Register New User  -->
                <StackPanel Grid.Column="0" Margin="5">

                    <!--  Section 1: Edit Own Profile  -->
                    <Border
                        Margin="0,0,0,15"
                        Padding="15"
                        Style="{StaticResource ModernCardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,15"
                                Style="{StaticResource SectionHeaderText}"
                                Text="👤 My Account Profile" />

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="First Name" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MyFirstName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Last Name" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MyLastName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Job Title" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MyTitle, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Department" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MyDepartment, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Margin="0,15,0,10"
                                Background="#20FFFFFF" />

                            <TextBlock
                                Margin="0,0,0,10"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="🔑 Change Password (Optional)" />

                            <StackPanel Margin="0,5">
                                <TextBlock Style="{StaticResource DetailLabelText}" Text="Current Password" />
                                <PasswordBox
                                    Name="TxtCurrentPassword"
                                    PasswordChanged="TxtCurrentPassword_PasswordChanged"
                                    Style="{StaticResource MaterialDesignPasswordBox}" />
                            </StackPanel>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="New Password" />
                                    <PasswordBox
                                        Name="TxtNewPassword"
                                        PasswordChanged="TxtNewPassword_PasswordChanged"
                                        Style="{StaticResource MaterialDesignPasswordBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Confirm New Password" />
                                    <PasswordBox
                                        Name="TxtConfirmNewPassword"
                                        PasswordChanged="TxtConfirmNewPassword_PasswordChanged"
                                        Style="{StaticResource MaterialDesignPasswordBox}" />
                                </StackPanel>
                            </Grid>

                            <Button
                                Margin="0,15,0,5"
                                HorizontalAlignment="Left"
                                Command="{Binding SaveMyProfileCommand}"
                                Content="💾 Save Profile Changes"
                                Style="{StaticResource ModernActionButton}" />
                        </StackPanel>
                    </Border>

                    <!--  Section 2: Register New User Account  -->
                    <Border Padding="15" Style="{StaticResource ModernCardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,5"
                                Style="{StaticResource SectionHeaderText}"
                                Text="➕ Register New Account" />
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="11"
                                Foreground="#AAAAAA"
                                Text="Create a new system user account. Account types are Client and Guest (Only Admin users can register another Admin)."
                                TextWrapping="Wrap" />

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Username *" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Account Role *" />
                                    <ComboBox
                                        ItemsSource="{Binding AvailableRoles}"
                                        SelectedItem="{Binding SelectedRole}"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="First Name" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegFirstName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Last Name" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegLastName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Job Title" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegTitle, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Department" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegDepartment, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Password *" />
                                    <PasswordBox
                                        Name="TxtRegPassword"
                                        PasswordChanged="TxtRegPassword_PasswordChanged"
                                        Style="{StaticResource MaterialDesignPasswordBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Style="{StaticResource DetailLabelText}" Text="Confirm Password *" />
                                    <PasswordBox
                                        Name="TxtRegConfirmPassword"
                                        PasswordChanged="TxtRegConfirmPassword_PasswordChanged"
                                        Style="{StaticResource MaterialDesignPasswordBox}" />
                                </StackPanel>
                            </Grid>

                            <Button
                                Margin="0,15,0,5"
                                HorizontalAlignment="Left"
                                Command="{Binding RegisterUserCommand}"
                                Content="✨ Register User Account"
                                Style="{StaticResource ModernActionButton}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!--  Right Column: User Directory DataGrid  -->
                <StackPanel Grid.Column="1" Margin="5">
                    <Border Padding="15" Style="{StaticResource ModernCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionHeaderText}"
                                    Text="📋 Registered System Users" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding LoadUsersCommand}"
                                    Content="🔄 Refresh"
                                    Style="{StaticResource ModernSecondaryButton}" />
                            </Grid>

                            <DataGrid
                                MaxHeight="700"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding UserDirectory}"
                                Style="{StaticResource ModernDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding UserId}"
                                        Header="ID" />
                                    <DataGridTextColumn
                                        Width="110"
                                        Binding="{Binding Username}"
                                        Header="Username" />
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding AccountName}"
                                        Header="First Name" />
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding AccountSurname}"
                                        Header="Last Name" />
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding AccountType}"
                                        Header="Role" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding AccountTitle}"
                                        Header="Job Title" />
                                    <DataGridTextColumn
                                        Width="110"
                                        Binding="{Binding AccountDepartment}"
                                        Header="Department" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>
