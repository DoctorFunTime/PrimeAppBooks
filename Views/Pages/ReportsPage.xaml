<base:BaseAnimatedPage
    x:Class="PrimeAppBooks.Views.Pages.ReportsPage"
    xmlns:base="clr-namespace:PrimeAppBooks.Views.Pages"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:converters="clr-namespace:PrimeAppBooks.Conveters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pages="clr-namespace:PrimeAppBooks.ViewModels.Pages" d:DataContext="{d:DesignInstance Type=pages:ReportsPageViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1280"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource ModernScrollViewer}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header Section Matching Chart of Accounts  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,20"
                Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource WelcomeTitleText}" Text="Financial Reports" />
                        <TextBlock Style="{StaticResource WelcomeSubtitleText}" Text="Generate, print, and manage your financial reports" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Margin="5,0"
                            Command="{Binding PrintAllCommand}"
                            Content="🖨️ Print All (Draft)"
                            Style="{StaticResource ModernSecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Date Range Filter Section  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,20"
                Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SectionHeaderText}"
                        Text="📅 Date Range" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <DatePicker
                            Width="120"
                            Margin="0,0,10,0"
                            SelectedDate="{Binding StartDate, Mode=TwoWay}"
                            Style="{StaticResource CompactDatePickerStyle}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="to" />
                        <DatePicker
                            Width="120"
                            Margin="10,0,10,0"
                            SelectedDate="{Binding EndDate, Mode=TwoWay}"
                            Style="{StaticResource CompactDatePickerStyle}" />
                        <ComboBox
                            Width="120"
                            ItemsSource="{Binding DatePresets}"
                            SelectedItem="{Binding SelectedDatePreset}"
                            Style="{StaticResource ModernComboBox}" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Command="{Binding ApplyDateFilterCommand}"
                        Content="Apply"
                        Style="{StaticResource ModernActionButton}" />
                </Grid>
            </Border>

            <!--  Main Content  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!--  Report Types  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,15,0"
                    Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,15"
                            Style="{StaticResource SectionHeaderText}"
                            Text="📋 Report Types" />

                        <!--  Standard Reports  -->
                        <Expander Margin="0,0,0,10" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock
                                    Foreground="Black"
                                    Style="{StaticResource DetailHeaderText}"
                                    Text="📄 Financial Statements" />
                            </Expander.Header>
                            <StackPanel>
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateBalanceSheetCommand}"
                                    Content="Balance Sheet"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateIncomeStatementCommand}"
                                    Content="Income Statement"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateTrialBalanceCommand}"
                                    Content="Trial Balance"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateCashFlowCommand}"
                                    Content="Cash Flow Statement"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateAssetRegisterCommand}"
                                    Content="Asset Register"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Expander>

                        <!--  Management Reports  -->
                        <Expander Margin="0,0,0,10" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock
                                    Foreground="Black"
                                    Style="{StaticResource DetailHeaderText}"
                                    Text="📊 Analysis Reports" />
                            </Expander.Header>
                            <StackPanel>
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateReceivablesSummaryCommand}"
                                    Content="Receivables Master Summary"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateArAgingCommand}"
                                    Content="A/R Aging Summary"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateApAgingCommand}"
                                    Content="A/P Aging Summary"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Expander>

                        <!--  Tax Reports  -->
                        <Expander Margin="0,0,0,10" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock
                                    Foreground="Black"
                                    Style="{StaticResource DetailHeaderText}"
                                    Text="🧾 Tax Reports" />
                            </Expander.Header>
                            <StackPanel>
                                <Button
                                    Margin="0,5"
                                    Command="{Binding GenerateTaxReportCommand}"
                                    Content="Tax Summary (VAT)"
                                    Style="{StaticResource ModernSecondaryButton}" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!--  Report Configuration & Recent  -->
                <!--  Recent Reports  -->
                <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,15"
                            Style="{StaticResource SectionHeaderText}"
                            Text="🕐 Recently Generated Reports" />

                        <ListView ItemsSource="{Binding RecentReports}" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="12"
                                        Background="#2D2D2D"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="#3D3D3D">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,15,0"
                                                FontSize="20"
                                                VerticalAlignment="Center"
                                                Text="{Binding Icon}" />
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    FontSize="14"
                                                    Foreground="White"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#888888"
                                                    Text="{Binding GeneratedDate, StringFormat='Generated: {0:MMM dd, yyyy HH:mm}'}" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="2"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Content="Open PDF"
                                                Style="{StaticResource ModernActionButton}"
                                                Padding="10,4" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        
                        <TextBlock 
                            Visibility="{Binding RecentReports.Count, Converter={StaticResource LengthToVisibilityConverter}}" 
                            Text="No reports generated in this session yet." 
                            Foreground="#666666" 
                            HorizontalAlignment="Center" 
                            Margin="0,20"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</base:BaseAnimatedPage>
