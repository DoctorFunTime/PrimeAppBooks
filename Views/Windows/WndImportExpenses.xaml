<Window
    x:Class="PrimeAppBooks.Views.Windows.WndImportExpenses"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Import Cashbook Expenses"
    Width="1120" Height="720"
    MinWidth="900" MinHeight="550"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Root border -->
    <Border CornerRadius="12" Background="#1a1f2e"
            BorderBrush="#2c3e50" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>    <!-- title bar -->
                <RowDefinition Height="Auto"/>  <!-- filter bar -->
                <RowDefinition Height="Auto"/>  <!-- connection settings -->
                <RowDefinition Height="*"/>     <!-- data grid -->
                <RowDefinition Height="Auto"/>  <!-- account defaults bar -->
                <RowDefinition Height="Auto"/>  <!-- totals & action bar -->
                <RowDefinition Height="Auto"/>  <!-- session summary (collapsible) -->
            </Grid.RowDefinitions>

            <!-- ══ Title Bar ══════════════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#0d1117"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="💸" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Import Cashbook Expenses" Foreground="White"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Last import info -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Last import: " Foreground="#7f8c8d" FontSize="12"/>
                        <TextBlock Text="{Binding LastExpenseImportDateText}" Foreground="#3498db" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Width="28" Height="28" Margin="3,0"
                                Content="—" Foreground="#bdc3c7" Background="Transparent"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                Command="{Binding MinimizeCommand}"/>
                        <Button Width="28" Height="28" Margin="3,0"
                                Content="✕" Foreground="#e74c3c" Background="Transparent"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Filter Bar ═════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="#111827" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="From:" Foreground="#bdc3c7"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="1"
                                SelectedDate="{Binding StartDate}"
                                Style="{StaticResource CompactDatePickerStyle}"/>

                    <TextBlock Grid.Column="2" Text="→" Foreground="#7f8c8d"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3" Text="To:" Foreground="#bdc3c7"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="4"
                                SelectedDate="{Binding EndDate}"
                                Style="{StaticResource CompactDatePickerStyle}"/>

                    <!-- Import Type -->
                    <TextBlock Grid.Column="6" Text="Type:" Foreground="#bdc3c7"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox Grid.Column="7"
                              ItemsSource="{Binding ImportTypes}"
                              SelectedItem="{Binding ImportType}"
                              Style="{StaticResource ModernComboBox}"
                              Height="34"/>

                    <!-- Status message -->
                    <TextBlock Grid.Column="9" Text="{Binding StatusMessage}"
                               Foreground="#95a5a6" FontStyle="Italic"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="10"
                            Width="130" Height="34"
                            Command="{Binding LoadExpensesCommand}"
                            Content="🔍 Load Expenses"
                            Style="{StaticResource ModernActionButton}"/>
                </Grid>
            </Border>

            <!-- ══ Connection Settings ════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#0d1117" Padding="16,8" BorderBrush="#2c3e50" BorderThickness="0,1,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Use External Connection" IsChecked="{Binding UseExternalConnection}" 
                              Foreground="White" VerticalAlignment="Center" Margin="0,0,24,0"/>
                              
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseExternalConnection}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Host:" Foreground="#bdc3c7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ExternalHost, UpdateSourceTrigger=PropertyChanged}" Width="120" Background="#111827" Foreground="White" BorderThickness="1" BorderBrush="#2c3e50" Padding="4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseExternalConnection}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Port:" Foreground="#bdc3c7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ExternalPort, UpdateSourceTrigger=PropertyChanged}" Width="50" Background="#111827" Foreground="White" BorderThickness="1" BorderBrush="#2c3e50" Padding="4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseExternalConnection}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="DB:" Foreground="#bdc3c7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ExternalDatabase, UpdateSourceTrigger=PropertyChanged}" Width="160" Background="#111827" Foreground="White" BorderThickness="1" BorderBrush="#2c3e50" Padding="4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseExternalConnection}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="User:" Foreground="#bdc3c7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ExternalUsername, UpdateSourceTrigger=PropertyChanged}" Width="100" Background="#111827" Foreground="White" BorderThickness="1" BorderBrush="#2c3e50" Padding="4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseExternalConnection}" VerticalAlignment="Center">
                        <TextBlock Text="Pwd:" Foreground="#bdc3c7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ExternalPassword, UpdateSourceTrigger=PropertyChanged}" Width="100" Background="#111827" Foreground="White" BorderThickness="1" BorderBrush="#2c3e50" Padding="4"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- ══ DataGrid ═══════════════════════════════════════════════════ -->
            <DataGrid Grid.Row="3"
                      x:Name="ExpenseGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      Background="#1a1f2e"
                      Foreground="White"
                      RowBackground="#1e2a3a"
                      AlternatingRowBackground="#1a1f2e"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2c3e50"
                      ColumnHeaderStyle="{StaticResource MaterialDesignFlatDarkBgButton}"
                      CellStyle="{StaticResource MaterialDesignDataGridCell}"
                      RowHeight="54"
                      Margin="0">
                      
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignFlatDarkBgButton}">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                        <Setter Property="Height" Value="54" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2A4A7B" />
                                <!--  Selected background color  -->
                                <Setter Property="BorderBrush" Value="#4472C4" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A5F" />
                                <!--  Hover color  -->
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <!-- Select checkbox -->
                    <DataGridTemplateColumn Header="✓" Width="Auto" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="Date" Width="100" IsReadOnly="True"
                                        Binding="{Binding Date, StringFormat='yyyy-MM-dd'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Doc Number -->
                    <DataGridTextColumn Header="Doc #" Width="110" IsReadOnly="True"
                                        Binding="{Binding DocNumber}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Description (editable) -->
                    <DataGridTextColumn Header="Description" Width="*"
                                        Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#2c3e50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Amount (editable) -->
                    <DataGridTextColumn Header="Amount" Width="100"
                                        Binding="{Binding Amount, StringFormat='N2', UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#2c3e50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Currency -->
                    <DataGridTextColumn Header="Ccy" Width="55" IsReadOnly="True"
                                        Binding="{Binding CurrencyCode}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Expense / Cash Account (DR) (ComboBox) -->
                    <DataGridTemplateColumn Width="220">
                        <DataGridTemplateColumn.Header>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Expense Account (DR)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsExpenseImport, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Text" Value="Cash Account (DR)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedDebitAccount.FullName}"
                                           VerticalAlignment="Center" Margin="4,0"
                                           Foreground="{Binding SelectedDebitAccount, Converter={StaticResource NullColorConverter}, ConverterParameter='#e74c3c|White'}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SelectedDebitAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="FullName"
                                          TextSearch.TextPath="AccountName"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          hc:InfoElement.Placeholder="Select account"
                                          Style="{StaticResource ModernComboBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cash / Income Account (CR) (display only, editable via edit mode) -->
                    <DataGridTemplateColumn Width="180">
                        <DataGridTemplateColumn.Header>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Cash Account (CR)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsExpenseImport, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Text" Value="Income Account (CR)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedCreditAccount.FullName}"
                                           VerticalAlignment="Center" Margin="4,0" Foreground="#2ecc71"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SelectedCreditAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="FullName"
                                          TextSearch.TextPath="AccountName"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          Style="{StaticResource ModernComboBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- ══ Totals / Action Bar ════════════════════════════════════════ -->
            <Border Grid.Row="5" Background="#0d1117" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Select all -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Select All" Foreground="White"
                                  IsChecked="{Binding AllSelected}"
                                  Command="{Binding ToggleSelectAllCommand}"
                                  Margin="0,0,20,0"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#bdc3c7" FontSize="12">
                            <Run Text="{Binding SelectedRows}"/>
                            <Run Text="selected of"/>
                            <Run Text="{Binding TotalRows}"/>
                            <Run Text=" — Total:"/>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Foreground="#f39c12"
                                   FontWeight="Bold" FontSize="14" Margin="6,0"
                                   Text="{Binding SelectedTotal, StringFormat='N2'}"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <Button Grid.Column="2"
                            Width="160" Height="36" Margin="8,0,0,0"
                            Command="{Binding UndoLastExpenseImportCommand}"
                            Content="↩️ Undo Last Import"
                            Style="{StaticResource ModernSecondaryButton}"/>

                    <Button Grid.Column="3"
                            Width="160" Height="36" Margin="8,0,0,0"
                            Command="{Binding CloseCommand}"
                            Content="✕ Cancel"
                            Style="{StaticResource ModernSecondaryButton}"/>

                    <Button Grid.Column="4"
                            Width="180" Height="36" Margin="8,0,0,0"
                            Command="{Binding ImportSelectedCommand}"
                            Content="📥 Import Selected"
                            Style="{StaticResource ModernActionButton}"/>
                </Grid>
            </Border>

            <!-- ══ Session Summary (shown after import) ═══════════════════════ -->
            <Border Grid.Row="6"
                    Padding="16,12" Background="#162032"
                    BorderBrush="#2c3e50" BorderThickness="0,1,0,0"
                    Visibility="{Binding LastImportSessionSummary, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Last Session Summary" FontWeight="Bold" Foreground="#3498db" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding LastImportSessionSummary}"
                               Foreground="White" TextWrapping="Wrap" LineHeight="20" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ══ Loading Overlay ════════════════════════════════════════════ -->
            <!-- <Grid Grid.RowSpan="7" Background="#80000000"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <hc:LoadingCircle Foreground="White" Style="{StaticResource LoadingCircleLarge}"/>
                    <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"
                               Text="{Binding LoadingMessage}"/>
                    <TextBlock Foreground="#7f8c8d" HorizontalAlignment="Center"
                               Text="Please do not close the window..."/> 
                </StackPanel>
            </Grid>   -->
        </Grid>
    </Border>
</Window>
