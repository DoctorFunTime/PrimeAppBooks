<Window
    x:Class="PrimeAppBooks.Views.Wndlogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Sign In"
    Width="480"
    Height="560"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Century Gothic"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Grid Margin="10">
        <Border
            Margin="5"
            Panel.ZIndex="0"
            Background="#40000000"
            CornerRadius="8" />

        <Grid Panel.ZIndex="1">
            <Rectangle RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <StaticResource ResourceKey="BackgroundGradient1" />
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle
                Opacity="0.5"
                RadiusX="8"
                RadiusY="8">
                <Rectangle.Fill>
                    <StaticResource ResourceKey="BackgroundGradient2" />
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <StaticResource ResourceKey="BackgroundMaskGradient" />
                </Rectangle.OpacityMask>
            </Rectangle>

            <fw:AcrylicPanel
                NoiseOpacity="0.005"
                Opacity="0.9"
                TintColor="#0a0a0a"
                TintOpacity="0.1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Title bar  -->
                    <Border
                        Grid.Row="0"
                        Height="44"
                        CornerRadius="8,8,0,0">
                        <Border.Background>
                            <StaticResource ResourceKey="TitleBarGradient" />
                        </Border.Background>
                        <DockPanel Margin="12,0" LastChildFill="False">
                            <TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#D0FFFFFF"
                                Text="PrimeApp Books" />
                            <Button
                                Width="30"
                                Height="30"
                                Click="CloseButton_Click"
                                Content="✕"
                                DockPanel.Dock="Right"
                                Style="{StaticResource CloseButtonStyle}" />
                        </DockPanel>
                    </Border>

                    <!--  Login content  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="50,20,50,30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Image
                            Height="70"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Images/NewLogoIconDark.png"
                            Stretch="Uniform" />

                        <TextBlock
                            Margin="0,0,0,4"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Welcome back" />
                        <TextBlock
                            Margin="0,0,0,28"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="#90FFFFFF"
                            Text="Sign in to PrimeApp Books" />

                        <TextBox
                            x:Name="txtAccountName"
                            Width="320"
                            Margin="0,0,0,18"
                            Padding="5,20,10,5"
                            MaterialDesign:HintAssist.Background="Transparent"
                            MaterialDesign:HintAssist.Hint="Username"
                            FontFamily="Century Gothic"
                            FontSize="15"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <PasswordBox
                            x:Name="txtPassword"
                            Width="320"
                            Margin="0,0,0,30"
                            Padding="5,20,10,5"
                            MaterialDesign:HintAssist.Background="Transparent"
                            MaterialDesign:HintAssist.Hint="Password"
                            Background="Transparent"
                            FontFamily="Century Gothic"
                            FontSize="15"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}" />

                        <Button
                            x:Name="btnLogin"
                            Width="320"
                            Height="42"
                            Click="Button_Click"
                            Content="Sign In"
                            FontFamily="Century Gothic"
                            FontSize="16" />
                    </StackPanel>
                </Grid>
            </fw:AcrylicPanel>
        </Grid>
    </Grid>
</Window>
